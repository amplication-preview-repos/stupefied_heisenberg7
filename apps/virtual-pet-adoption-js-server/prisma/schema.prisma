datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  createdAt DateTime  @default(now())
  email     String?
  id        String    @id @default(cuid())
  message   String?
  sentAt    DateTime?
  updatedAt DateTime  @updatedAt
}

model Pet {
  bio               String?
  createdAt         DateTime                   @default(now())
  dateOfBirth       DateTime?
  healthCondition   String?
  id                String                     @id @default(cuid())
  location          String?
  mainGalleryPhotos Json?
  name              String?
  numberOfOwners    Int?
  personalityTraits EnumPetPersonalityTraits[]
  subscriptions     Subscription[]
  updatedAt         DateTime                   @updatedAt
}

model Subscription {
  createdAt DateTime                @default(now())
  endDate   DateTime?
  id        String                  @id @default(cuid())
  pet       Pet?                    @relation(fields: [petId], references: [id])
  petId     String?
  startDate DateTime?
  status    EnumSubscriptionStatus?
  updatedAt DateTime                @updatedAt
  user      User?                   @relation(fields: [userId], references: [id])
  userId    String?
}

model News {
  content     String?
  createdAt   DateTime  @default(now())
  id          String    @id @default(cuid())
  publishDate DateTime?
  title       String?
  updatedAt   DateTime  @updatedAt
}

model User {
  createdAt          DateTime                    @default(now())
  email              String?                     @unique
  firstName          String?
  id                 String                      @id @default(cuid())
  lastName           String?
  password           String
  roles              Json
  subscriptionLevel  EnumUserSubscriptionLevel?
  subscriptionStatus EnumUserSubscriptionStatus?
  subscriptions      Subscription[]
  updatedAt          DateTime                    @updatedAt
  username           String                      @unique
}

enum EnumPetPersonalityTraits {
  Option1
}

enum EnumSubscriptionStatus {
  Option1
}

enum EnumUserSubscriptionLevel {
  Option1
}

enum EnumUserSubscriptionStatus {
  Option1
}
